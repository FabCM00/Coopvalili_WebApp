generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User {
  id                  String               @id @default(cuid())
  name                String?
  email               String               @unique
  emailVerified       DateTime?            @db.Timestamptz(6)
  image               String?
  passwordHash        String?
  role                Role                 @default(USER)
  active              Boolean              @default(false)
  otpEnabled          Boolean              @default(false)
  createdAt           DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime             @default(now()) @updatedAt @db.Timestamptz(6)
  sentInvitations     InvitationToken[]    @relation("InvitedBy")
  passwordResetTokens PasswordResetToken[]
  loginOtps           LoginOtp[]

  @@index([email], map: "idx_user_email")
  @@index([role], map: "idx_user_role")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime @db.Timestamptz(6)
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_password_reset_user")

  @@index([token], map: "idx_password_reset_token")
  @@index([userId], map: "idx_password_reset_userid")
}

model LoginOtp {
  id        String   @id @default(cuid())
  userId    String
  codeHash  String
  expiresAt DateTime @db.Timestamptz(6)
  used      Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_login_otp_user")

  @@index([userId], map: "idx_login_otp_userid")
}

model InvitationToken {
  id          String   @id @default(cuid())
  email       String
  token       String   @unique
  role        Role     @default(USER)
  invitedById String
  expiresAt   DateTime @db.Timestamptz(6)
  accepted    Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  invitedBy   User     @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_invitation_invited_by")

  @@index([email], map: "idx_invitation_email")
  @@index([token], map: "idx_invitation_token")
}


model valida1_results {
  id                    BigInt                 @id @default(autoincrement())
  radicado              String                 @unique
  cedula                String?
  request_json          Json?
  response_json         Json?
  created_at            DateTime               @default(now()) @db.Timestamptz(6)
  updated_at            DateTime               @default(now()) @db.Timestamptz(6)
  gestionado_at         DateTime?              @db.Timestamptz(6)
  gestionado_by         String?
  credito_decisiones    credito_decisiones?
  document_results      document_results[]
  documentos            documentos[]
  identity_validations  identity_validations?
  motor_data_results    motor_data_results[]
  motor_process_results motor_process_results?

  @@index([cedula], map: "idx_valida1_cedula")
}

/// Índice de los archivos subidos. El contenido vive en Azure Blob Storage; aquí
/// solo se guarda el puntero (container + blob_name, al estilo bucket + key de
/// S3) junto con los metadatos y el estado. La FK a valida1_results garantiza
/// que no se pueda adjuntar un documento a una solicitud que no existe.
model documentos {
  id       BigInt @id @default(autoincrement())
  radicado String
  cedula   String

  // Puntero al blob. `container` se guarda explícito para soportar una futura
  // migración de contenedor sin perder la referencia de los ya existentes.
  container String @default("documentos")
  blob_name String

  // Metadatos del archivo
  nombre_original String
  mime_type       String?
  size_bytes      BigInt?
  /// SHA-256 del contenido: permite detectar que se subió dos veces el mismo archivo.
  sha256          String? @db.Char(64)
  /// Versión del blob en Azure (cambia con cada sobrescritura).
  etag            String?

  /// Tipo/carpeta del documento. Texto libre (p. ej. "Pagaré", "Cédula").
  tipo_documento String @default("Documentos generales")

  /// Estado del documento. Ver DOCUMENTO_ESTADOS en src/lib/documentos.ts:
  /// pendiente | revision | validado (manuales) y
  /// pendiente_firma | firmado (los pone el sistema vía ZapSign).
  estado String @default("pendiente")

  // Borrado lógico: nunca se borra el blob ni la fila.
  eliminado  Boolean   @default(false)
  deleted_at DateTime? @db.Timestamptz(6)

  subido_por String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  valida1_results   valida1_results     @relation(fields: [radicado], references: [radicado], onUpdate: NoAction, map: "fk_documentos_valida1")
  firma_solicitudes firma_solicitudes[]

  @@unique([container, blob_name], map: "uq_documentos_blob")
  @@index([radicado], map: "idx_documentos_radicado")
  @@index([cedula], map: "idx_documentos_cedula")
  @@index([radicado, estado], map: "idx_documentos_radicado_estado")
}

/// Envíos a firma electrónica (ZapSign). Un documento puede tener varios envíos
/// (reenvíos, intentos fallidos): el vigente es el más reciente con status
/// "pending". El webhook de ZapSign localiza la fila por `zapsign_token`.
model firma_solicitudes {
  id           BigInt @id @default(autoincrement())
  documento_id BigInt
  radicado     String

  /// Token del documento en ZapSign. Es la llave que trae el webhook.
  zapsign_token String  @unique
  /// open_id de ZapSign (identificador numérico visible en su panel).
  zapsign_open_id Int?
  /// URL de firma del firmante: se le reenvía si no recibió el correo.
  sign_url      String?
  /// Token del firmante en ZapSign (distinto del token del documento).
  signer_token  String?

  // Datos del firmante tal como se enviaron (el firmante puede editarlos en
  // ZapSign, así que esto es lo solicitado, no necesariamente lo final).
  firmante_nombre String
  firmante_email  String?
  firmante_phone  String?

  /// Canales por los que ZapSign notificó al firmante.
  canal_email    Boolean @default(true)
  canal_whatsapp Boolean @default(false)

  /// Estado del envío: pending | signed | refused | error.
  status String @default("pending")

  /// etag del blob antes de sobrescribirlo con el PDF firmado: deja rastro de
  /// que existió una versión sin firmar (el contenido en sí no se conserva).
  etag_original String?

  /// Payload crudo del último webhook recibido (auditoría y diagnóstico).
  webhook_json Json?

  enviado_por String?
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @updatedAt @db.Timestamptz(6)
  signed_at   DateTime? @db.Timestamptz(6)

  documento documentos @relation(fields: [documento_id], references: [id], onDelete: Cascade, map: "fk_firma_documento")

  @@index([documento_id], map: "idx_firma_documento")
  @@index([radicado], map: "idx_firma_radicado")
  @@index([status], map: "idx_firma_status")
}

model identity_validations {
  id              BigInt           @id @default(autoincrement())
  radicado        String?          @unique(map: "identity_validations_radicado_valida1_key")
  cedula          String?
  request_json    Json?
  response_json   Json?
  created_at      DateTime         @default(now()) @db.Timestamptz(6)
  updated_at      DateTime         @default(now()) @db.Timestamptz(6)
  valida1_results valida1_results? @relation(fields: [radicado], references: [radicado], onUpdate: NoAction, map: "fk_identity_valida1")

  @@index([cedula], map: "idx_identity_cedula")
  @@index([radicado], map: "idx_identity_radicado")
}

model motor_data_results {
  id              BigInt           @id @default(autoincrement())
  radicado        String?
  cedula          String?
  request_json    Json?
  response_json   Json?
  created_at      DateTime         @default(now()) @db.Timestamptz(6)
  updated_at      DateTime         @default(now()) @db.Timestamptz(6)
  valida1_results valida1_results? @relation(fields: [radicado], references: [radicado], onUpdate: NoAction, map: "fk_motor_data_valida1")

  @@index([cedula], map: "idx_motor_data_cedula")
  @@index([radicado], map: "idx_motor_data_radicado")
}

model motor_process_results {
  id              BigInt          @id @default(autoincrement())
  radicado        String          @unique
  cedula          String?
  request_json    Json?
  response_json   Json?
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  updated_at      DateTime        @default(now()) @db.Timestamptz(6)
  valida1_results valida1_results @relation(fields: [radicado], references: [radicado], onDelete: Cascade, onUpdate: NoAction, map: "fk_motor_process_valida1")

  @@index([cedula], map: "idx_motor_process_cedula")
}

model credito_decisiones {
  id              BigInt          @id @default(autoincrement())
  radicado        String          @unique
  request_json    Json?
  response_json   Json?
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  updated_at      DateTime        @default(now()) @db.Timestamptz(6)
  valida1_results valida1_results @relation(fields: [radicado], references: [radicado], onDelete: Cascade, onUpdate: NoAction, map: "fk_credito_valida1")
}

model document_results {
  id              BigInt           @id @default(autoincrement())
  radicado        String?
  cedula          String?
  request_json    Json?
  response_json   Json?
  created_at      DateTime         @default(now()) @db.Timestamptz(6)
  updated_at      DateTime         @default(now()) @db.Timestamptz(6)
  valida1_results valida1_results? @relation(fields: [radicado], references: [radicado], onUpdate: NoAction, map: "fk_document_valida1")

  @@index([cedula], map: "idx_document_cedula")
  @@index([radicado], map: "idx_document_radicado")
}

model datos_asociado {
  id                    BigInt   @id @default(autoincrement())
  cedula                String   @unique
  primer_apellido       String?
  nombre                String?
  nombre_asociado       String?
  ciudad                String?
  cliente_empresa       String?
  estado_civil          String?
  estado_civil_norm     String?
  tipo_vivienda         String?
  nivel                 String?
  usuario_credito       String?
  fecha_ingreso         String?
  fecha_ingreso_empresa String?
  edad                  Decimal? @db.Decimal
  personas_cargo        Decimal? @db.Decimal
  antiguedad_coop       Decimal? @db.Decimal
  antiguedad_laboral    Decimal? @db.Decimal
  salario               Decimal? @db.Decimal
  aportes               Decimal? @db.Decimal
  deuda_coopvalili      Decimal? @db.Decimal
  cuota_disponible      Decimal? @db.Decimal
  created_at            DateTime @default(now()) @db.Timestamptz(6)
  updated_at            DateTime @default(now()) @db.Timestamptz(6)

  @@index([cedula], map: "idx_datos_asociado_cedula")
}

enum Role {
  USER
  ADMIN
}
